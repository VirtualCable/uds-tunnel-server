# =============================================================================
# UDS Tunnel Server — Sample Configuration
# =============================================================================
# This file contains the default and recommended settings for the UDS Tunnel.
# Mount this file into the container:
#   docker run -v ./udstunnel.conf:/etc/udstunnel.conf:ro ...
# =============================================================================

# --- Network Settings ---

# IP address to listen on. "*" means all interfaces.
listen_addr = "*"

# Port to listen on.
listen_port = 4443

# Whether to expect PROXY protocol v2 headers (if behind a proxy like HAProxy).
use_proxy_protocol = false

# Master switch for the UDP relay leg (RDP UDP redirection). Default: true.
# The per-session gate is the broker's enable_udp flag; this only controls
# whether the shared UDP socket is bound. If the bind fails, the server
# keeps serving TCP only.
# udp_enabled = true

# Port for the shared UDP relay socket. Default: same as listen_port.
# Can also be overridden with the UDSTUNNEL_UDP_LISTEN_PORT env var.
# udp_listen_port = 4443


# --- Broker API Settings ---

# URL of the UDS Broker Tunnel API endpoint.
# Example: "https://your-broker.example.com/uds/rest/tunnel/ticket"
ticket_api_url = "https://127.0.0.1:8443/uds/rest/tunnel/ticket"

# SECURITY: setting this to `true` disables TLS certificate validation
# on the broker API client. Useful for diagnostics against
# self-signed brokers; **never** enable in production. Default `false`.
#
# Only used by the Docker image for offline smoke tests; production
# configs should leave this unset (or explicitly set to `false`).
dangerous_disable_ssl_verify = false

# Authentication token for the Broker API.
# Must match the token configured in the UDS Broker.
broker_auth_token = "your-secret-token-here"


# --- Performance Settings ---

# Size of the session recovery buffer in KB. Default: 64
recovery_buffer_size = 64

# Hard cap on concurrent sessions. Default: 8192
# max_sessions = 8192

# Per-source-IP session cap. Unset (commented) = disabled. Behind NAT/CGNAT
# choose a large value; too low silently locks out legitimate tenants that
# share an egress address.
# max_sessions_per_remote = 128

# Data-idle session cap in seconds: a session carrying no payload bytes for
# this long is ended (keep-alive Nop frames do NOT count as payload).
# Default: 120; 0 disables the cap.
# session_idle_data_timeout_secs = 120

# Rekeying threshold: log2 of the frames per AES-GCM key epoch. Every 2^k
# sequence numbers the tunnel re-derives a fresh key (NIST SP 800-38D per-key
# bound). 0 = OFF (single key for the whole session); 1..=63 = that threshold;
# values above 63 are clamped with a warning. Default: 20.
# Changing this requires BOTH server and launcher on the rekeying wire format
# (OpenResponse is 91 bytes); a pre-rekeying launcher is rejected outright.
# rekey_seq_log2 = 20


# --- Logging Settings ---

# Log level for the server. Options: "trace", "debug", "info", "warn", "error".
log_level = "info"

# NOTE: The log file path is NOT configured here.
# It is controlled by the UDSTUNNEL_TUNNEL_LOG_PATH environment variable.
# Inside the Docker container, it defaults to /var/log/udstunnel/uds-tunnel.log
# and the panic log to /var/log/udstunnel/udstunnel-panic.log
